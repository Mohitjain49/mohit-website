{
    "name": "mohit-website",
    "type": "module",
    "private": true,
    "version": "3.18.3",
    "engines": {
        "node": "26.1.0",
        "npm": "11.15.0"
    },
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt generate && node scripts/postbuild.mjs",
        "preview": "npm run serve",
        "nuxt:preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "open": "nuxt dev --open",
        "open:build": "npm run build && npm run serve",
        "update": "npx npm-check-updates",
        "update-git-hooks": "npx simple-git-hooks",
        "serve": "node scripts/serve-build.mjs",
        "deploy": "node scripts/deploy.mjs",
        "upgrade": "node scripts/upgrade.mjs",
        "nuke-install": "node scripts/nuke-install.mjs",
        "pdf-metadata": "node scripts/pdf-metadata.mjs",
        "docker:run": "node scripts/use-docker.mjs",
        "docker:build": "docker build -t mohit_website .",
        "docker:start": "docker run --env-file .env --env PORT=5700 --env HOST=0.0.0.0 -p 5700:5700 --name mohit_website_main_docker_container mohit_website",
        "docker:stop": "docker stop mohit_website_main_docker_container",
        "docker:rm": "docker rm mohit_website_main_docker_container",
        "test": "npx jest"
    },
    "dependencies": {
        "@comark/nuxt": "^0.6.2",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/vue-fontawesome": "^3.3.3",
        "@libpdf/core": "^0.4.1",
        "@nuxt/fonts": "^0.14.0",
        "@nuxtjs/robots": "^6.2.0",
        "@nuxtjs/sitemap": "^8.4.0",
        "@pinia/nuxt": "^1.0.2",
        "@tsparticles/slim": "4.3.2",
        "@tsparticles/vue3": "4.3.2",
        "@vite-pwa/nuxt": "^1.1.1",
        "@vueuse/nuxt": "^14.4.0",
        "animate.css": "^4.1.1",
        "bowser": "^2.14.1",
        "dayjs": "^1.11.23",
        "lenis": "^1.3.26",
        "libphonenumber-js": "^1.13.11",
        "lodash-es": "^4.18.1",
        "nuxt": "4.5.2",
        "nuxt-vitalizer": "^3.0.0",
        "ofetch": "^1.5.1",
        "pdfjs-dist": "^6.2.108",
        "pinia": "^4.0.3",
        "pretty-bytes": "^7.1.1",
        "qr-code-styling": "^1.9.2",
        "serve-handler": "^6.1.7",
        "validator": "^13.15.35",
        "vue": "^3.5.41",
        "vue-qrcode-reader": "^5.7.3",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudfront": "^3.1115.0",
        "@aws-sdk/client-s3": "^3.1115.0",
        "@stefanobartoletti/nuxt-social-share": "^3.2.0",
        "@types/google.picker": "^0.0.52",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^26.2.0",
        "@types/validator": "^13.15.10",
        "dotenv": "^17.4.2",
        "glob": "^13.0.6",
        "jest": "^30.4.2",
        "mime-types": "^3.0.2",
        "sass": "^1.103.1",
        "shiki": "^4.4.3",
        "simple-git-hooks": "^2.13.1",
        "unplugin-info": "^1.3.2",
        "vite-imagetools": "^12.0.0"
    },
    "simple-git-hooks": {
        "pre-commit": "npm.cmd run test"
    },
    "overrides": {
        "esbuild": "0.28.1",
        "brace-expansion": "5.0.9"
    }
}
