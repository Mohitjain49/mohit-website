{
    "name": "mohit-website",
    "version": "3.3.3",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite-ssg build && node scripts/postbuild.mjs",
        "preview": "vite preview",
        "open": "vite --open",
        "open:host": "vite --open --host",
        "open:preview": "vite preview --open",
        "open:build": "npm run build && npm run open:preview",
        "build:test": "npm run test && npm run build",
        "deploy": "node scripts/deploy.mjs",
        "update": "npx npm-check-updates",
        "test": "vitest run"
    },
    "dependencies": {
        "@fontsource/lexend": "^5.2.11",
        "@fontsource/montserrat": "^5.2.8",
        "@fontsource/roboto": "^5.2.8",
        "@fortawesome/fontawesome-svg-core": "^7.1.0",
        "@fortawesome/free-brands-svg-icons": "^7.1.0",
        "@fortawesome/free-solid-svg-icons": "^7.1.0",
        "@fortawesome/vue-fontawesome": "^3.1.2",
        "@tato30/vue-pdf": "^1.11.5",
        "@tsparticles/preset-fireworks": "^3.2.0",
        "@tsparticles/slim": "^3.9.1",
        "@tsparticles/vue3": "^3.0.1",
        "@vueuse/core": "^14.0.0",
        "animate.css": "^4.1.1",
        "markdown-it-attrs": "^4.3.1",
        "ofetch": "^1.4.1",
        "pdf-lib": "^1.17.1",
        "pinia": "^3.0.3",
        "qr-code-styling": "^1.9.2",
        "vue": "^3.5.22",
        "vue-qrcode-reader": "^5.7.3"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudfront": "^3.917.0",
        "@aws-sdk/client-s3": "^3.917.0",
        "@unhead/vue": "^2.0.19",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/test-utils": "^2.4.6",
        "dotenv": "^17.2.3",
        "mime-types": "^3.0.1",
        "unplugin-auto-import": "^20.2.0",
        "unplugin-imagemin": "^0.6.9",
        "unplugin-info": "^1.2.4",
        "unplugin-vue-components": "^30.0.0",
        "unplugin-vue-markdown": "^29.2.0",
        "vite": "^7.1.12",
        "vite-plugin-env-types": "^0.1.4",
        "vite-plugin-pwa": "^1.1.0",
        "vite-plugin-qrcode": "^0.3.0",
