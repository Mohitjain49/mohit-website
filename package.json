{
    "name": "mohit-website",
    "type": "module",
    "private": true,
    "version": "3.12.1",
    "engines": {
        "node": "26.1.0",
        "npm": "11.14.1"
    },
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt generate && node scripts/postbuild.mjs",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "open": "nuxt dev --open",
        "open:build": "npm run build && npm run serve",
        "serve": "npx serve .output/public -l 3007",
        "update": "npx npm-check-updates",
        "update-git-hooks": "npx simple-git-hooks",
        "deploy": "node scripts/deploy.mjs",
        "upgrade": "node scripts/upgrade.mjs",
        "upgrade:nuxt": "npx nuxt upgrade",
        "test": "npx jest"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-brands-svg-icons": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@fortawesome/vue-fontawesome": "^3.2.0",
        "@nuxt/content": "^3.14.0",
        "@nuxt/fonts": "^0.14.0",
        "@nuxtjs/robots": "^6.0.8",
        "@nuxtjs/sitemap": "^8.0.15",
        "@pinia/nuxt": "^0.11.3",
        "@tato30/vue-pdf": "^2.0.2",
        "@tsparticles/slim": "^4.0.5",
        "@tsparticles/vue3": "^4.0.5",
        "@vite-pwa/nuxt": "^1.1.1",
        "@vueuse/nuxt": "^14.3.0",
        "animate.css": "^4.1.1",
        "better-sqlite3": "^12.10.0",
        "dayjs": "^1.11.20",
        "lenis": "^1.3.23",
        "libphonenumber-js": "^1.13.2",
        "nuxt": "^4.4.6",
        "ofetch": "^1.5.1",
        "pdf-lib": "^1.17.1",
        "pinia": "^3.0.4",
        "qr-code-styling": "^1.9.2",
        "vue": "^3.5.34",
        "vue-qrcode-reader": "^5.7.3",
        "vue-router": "^5.0.7"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudfront": "^3.1050.0",
        "@aws-sdk/client-s3": "^3.1050.0",
        "@stefanobartoletti/nuxt-social-share": "^3.0.0",
        "@types/node": "^25.9.1",
        "dotenv": "^17.4.2",
        "glob": "^13.0.6",
        "jest": "^30.4.2",
        "mime-types": "^3.0.2",
        "sass": "^1.99.0",
        "shiki": "^4.1.0",
        "simple-git-hooks": "^2.13.1",
        "unplugin-info": "^1.3.2",
        "vite-imagetools": "^10.0.0"
    },
    "overrides": {
        "serialize-javascript": "^7.0.4",
        "ws": "^8.20.1"
    },
    "simple-git-hooks": {
        "pre-commit": "npm.cmd run test"
    }
}
