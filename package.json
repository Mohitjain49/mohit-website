{
    "name": "mohit-website",
    "type": "module",
    "private": true,
    "version": "3.15.8",
    "engines": {
        "node": "26.1.0",
        "npm": "11.15.0"
    },
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt generate && node scripts/postbuild.mjs",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "nuke-install": "npm run upgrade -- --skip-exclude-deps --skip-update-deps --skip-update-version --install-deps --update-git-hooks",
        "open": "nuxt dev --open",
        "open:build": "npm run build && npm run serve",
        "update": "npx npm-check-updates",
        "update-git-hooks": "npx simple-git-hooks",
        "serve": "node scripts/serve-build.mjs",
        "deploy": "node scripts/deploy.mjs",
        "upgrade": "node scripts/upgrade.mjs",
        "upgrade:nuxt": "npx nuxt upgrade",
        "pdf-metadata": "node scripts/pdf-metadata.mjs",
        "docker:run": "node scripts/use-docker.mjs",
        "docker:build": "docker build -t mohit_website .",
        "docker:start": "docker run --env-file .env --env PORT=5700 --env HOST=0.0.0.0 -p 5700:5700 --name mohit_website_main_docker_container mohit_website",
        "docker:stop": "docker stop mohit_website_main_docker_container",
        "docker:rm": "docker rm mohit_website_main_docker_container",
        "test": "npx jest"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.3.0",
        "@fortawesome/free-brands-svg-icons": "^7.3.0",
        "@fortawesome/free-solid-svg-icons": "^7.3.0",
        "@fortawesome/vue-fontawesome": "^3.3.0",
        "@libpdf/core": "^0.4.1",
        "@nuxt/content": "^3.15.0",
        "@nuxt/fonts": "^0.14.0",
        "@nuxtjs/robots": "^6.1.2",
        "@nuxtjs/sitemap": "^8.2.2",
        "@pinia/nuxt": "^0.11.3",
        "@tsparticles/slim": "4.3.1",
        "@tsparticles/vue3": "4.3.1",
        "@vite-pwa/nuxt": "^1.1.1",
        "@vueuse/nuxt": "^14.3.0",
        "animate.css": "^4.1.1",
        "better-sqlite3": "^12.11.1",
        "dayjs": "^1.11.21",
        "lenis": "^1.3.25",
        "libphonenumber-js": "^1.13.8",
        "lodash-es": "^4.18.1",
        "nuxt": "^4.4.8",
        "nuxt-vitalizer": "^2.0.0",
        "ofetch": "^1.5.1",
        "pdfjs-dist": "^6.1.200",
        "pinia": "^3.0.4",
        "pretty-bytes": "^7.1.0",
        "qr-code-styling": "^1.9.2",
        "validator": "^13.15.35",
        "vue": "^3.5.39",
        "vue-qrcode-reader": "^5.7.3",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudfront": "^3.1083.0",
        "@aws-sdk/client-s3": "^3.1083.0",
        "@stefanobartoletti/nuxt-social-share": "^3.1.0",
        "@types/google.picker": "^0.0.52",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^26.1.1",
        "@types/validator": "^13.15.10",
        "dotenv": "^17.4.2",
        "glob": "^13.0.6",
        "jest": "^30.4.2",
        "mime-types": "^3.0.2",
        "sass": "^1.101.0",
        "serve": "^14.2.6",
        "shiki": "^4.3.1",
        "simple-git-hooks": "^2.13.1",
        "unplugin-info": "^1.3.2",
        "vite-imagetools": "^10.0.1"
    },
    "simple-git-hooks": {
        "pre-commit": "npm.cmd run test"
    },
    "overrides": {
        "esbuild": "^0.28.1",
        "js-yaml": "4.2.0"
    }
}
