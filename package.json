{
    "name": "mohit-website",
    "type": "module",
    "private": true,
    "version": "3.15.0",
    "engines": {
        "node": "26.1.0",
        "npm": "11.15.0"
    },
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt generate && node scripts/postbuild.mjs",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "open": "nuxt dev --open",
        "open:build": "npm run build && npm run serve",
        "serve": "npx serve .output/public -l 3007",
        "update": "npx npm-check-updates",
        "update-git-hooks": "npx simple-git-hooks",
        "deploy": "node scripts/deploy.mjs",
        "upgrade": "node scripts/upgrade.mjs",
        "upgrade:nuxt": "npx nuxt upgrade",
        "test": "npx jest"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-brands-svg-icons": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@fortawesome/vue-fontawesome": "^3.2.0",
        "@libpdf/core": "^0.3.6",
        "@nuxt/content": "^3.14.0",
        "@nuxt/fonts": "^0.14.0",
        "@nuxtjs/robots": "^6.0.9",
        "@nuxtjs/sitemap": "^8.1.0",
        "@pinia/nuxt": "^0.11.3",
        "@tato30/vue-pdf": "^2.1.0",
        "@tsparticles/slim": "^4.1.3",
        "@tsparticles/vue3": "^4.1.3",
        "@vite-pwa/nuxt": "^1.1.1",
        "@vueuse/nuxt": "^14.3.0",
        "animate.css": "^4.1.1",
        "better-sqlite3": "^12.10.0",
        "dayjs": "^1.11.21",
        "lenis": "^1.3.23",
        "libphonenumber-js": "^1.13.6",
        "lodash-es": "^4.18.1",
        "nuxt": "^4.4.8",
        "nuxt-vitalizer": "^2.0.0",
        "ofetch": "^1.5.1",
        "pinia": "^3.0.4",
        "qr-code-styling": "^1.9.2",
        "validator": "^13.15.35",
        "vue": "^3.5.35",
        "vue-qrcode-reader": "^5.7.3",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudfront": "^3.1063.0",
        "@aws-sdk/client-s3": "^3.1063.0",
        "@stefanobartoletti/nuxt-social-share": "^3.0.3",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^25.9.2",
        "@types/validator": "^13.15.10",
        "dotenv": "^17.4.2",
        "glob": "^13.0.6",
        "jest": "^30.4.2",
        "mime-types": "^3.0.2",
        "sass": "^1.100.0",
        "shiki": "^4.2.0",
        "simple-git-hooks": "^2.13.1",
        "unplugin-info": "^1.3.2",
        "vite-imagetools": "^10.0.0"
    },
    "simple-git-hooks": {
        "pre-commit": "npm.cmd run test"
    }
}
